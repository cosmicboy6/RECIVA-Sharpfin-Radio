# ---------------------------------------------------------------------------
# RECIVA Deployment-Konfiguration
# Kopieren zu .env und alle Platzhalter ersetzen. .env ist gitignored!
# ---------------------------------------------------------------------------

# Docker / Netz
RECIVA_NET=reciva-net
SUBNET=192.168.0.0/24
GATEWAY=192.168.0.1
PARENT_IFACE=eth0
PATCHSERVER_IP=192.168.0.240
DNS_PROXY_IP=192.168.0.242
UPSTREAM_DNS=192.168.0.1
IMAGE_NAME=reciva-patchserver:local

# Radio (gerätebezogen, geheim)
RADIO_IP=192.168.0.39
SERIAL="<SERIAL>"
DES_KEY="<DES_KEY>"
PASSWORT="<PASSWORT>"

# Für die geplante HA-Integration reserviert - aktuell nicht verwendet.
HA_TOKEN="<HA_TOKEN>"
